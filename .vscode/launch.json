		{ // JSR PKG VERSION DOES NOT EXIST
            "name": "JSR Pkg Version Does Not Exist",
            "request": "launch",
            "type": "node",
            "program": "${workspaceFolder}/.github/cicd/scripts/jsr-pkg-version-does-not-exist.ts",
