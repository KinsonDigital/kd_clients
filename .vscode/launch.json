{
    "version": "0.2.0",
    "configurations": [
		{ // PLAYGROUND
            "name": "Playground",
            "request": "launch",
            "type": "node",
            "program": "${workspaceFolder}/.github/cicd/playground.ts",
			"cwd": "${workspaceFolder}",
            "runtimeArgs": [
                "run",
                "--inspect-wait",
                "--allow-all",
            ],
			"env": {
				"OWNER_NAME": "KinsonDigital",
				"REPO_NAME": "kd_clients",
				"GITHUB_TOKEN": "${env:CICD_TOKEN}",
				"WORKING_DIR": "${workspaceFolder}",
			},
            "attachSimplePort": 9229,
            "runtimeExecutable": "npm",
			"outputCapture": "std",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "windows": {
                "runtimeExecutable": "${userHome}\\.deno\\bin\\deno.exe"
            },
            "linux": {
                "runtimeExecutable": "${userHome}/.deno/bin/deno"
            },
        },
		{ // DEBUG TEST TILE
            "name": "Debug Test File",
            "request": "launch",
            "type": "node",
            "cwd": "${workspaceFolder}/tests",
            "runtimeArgs": [
                "test",
                "--inspect-brk",
                "--allow-all",
				"${fileBasename}",
            ],
            "attachSimplePort": 9229,
            "runtimeExecutable": "npm",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "windows": {
                "runtimeExecutable": "${userHome}\\.deno\\bin\\deno.exe"
            },
            "linux": {
                "runtimeExecutable": "${userHome}/.deno/bin/deno"
            },
        },
		{ // VALIDATE TAG
            "name": "Validate Tag",
            "request": "launch",
            "type": "node",
            "program": "${workspaceFolder}/.github/cicd/scripts/validate-tag.ts",
			"cwd": "${workspaceFolder}",
            "runtimeArgs": [
                "run",
                "-EN",
                "--inspect-wait",
            ],
			"env": {
				"OWNER_NAME": "KinsonDigital",
				"REPO_NAME": "kd_clients",
				"VERSION": "v1.0.0-preview.14",
				"GITHUB_TOKEN": "${env:CICD_TOKEN}"
			},
            "attachSimplePort": 9229,
            "runtimeExecutable": "npm",
			"outputCapture": "std",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "windows": {
                "runtimeExecutable": "${userHome}\\.deno\\bin\\deno.exe"
            },
            "linux": {
                "runtimeExecutable": "${userHome}/.deno/bin/deno"
            },
        },
		{ // MILESTONE EXISTS
            "name": "Milestone Exists",
            "request": "launch",
            "type": "node",
            "program": "${workspaceFolder}/.github/cicd/scripts/milestone-exists.ts",
			"cwd": "${workspaceFolder}",
